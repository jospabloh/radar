{
  // User — the Base44 auth user, extended with platform/tenant fields.
  //
  // SECURITY: role/app_role/company_id carry FIELD-LEVEL write RLS locking them
  // to role `admin` — the tier the service role evaluates as. End users
  // therefore CANNOT set their own role or company via auth.updateMe (that path
  // let any self-registered user escalate to admin, or hop into any other
  // company's data by self-setting company_id). All legitimate changes now flow
  // through the service-role backend function `completeOnboarding`.
  //
  // DEPLOY ORDER: deploy `completeOnboarding` FIRST, then this schema. If the
  // lock lands before the function is live, onboarding silently no-ops (Base44
  // drops disallowed field writes from the old client-side updateMe calls) and
  // new users get stuck.
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "app_role": {
      "type": "string",
      "enum": [
        "super_admin",
        "company_admin",
        "store_manager",
        "employee"
      ],
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "company_id": {
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "employee_id": {
      "type": "string",
      "description": "Employee row this account is linked to (set by completeOnboarding). Lets self-service writes on employee-owned entities (e.g. AttendanceRecord) require data.employee_id == {{user.data.employee_id}} instead of trusting a client-supplied employee_id.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "rls": {
    "read": {
      "$or": [
        { "id": "{{user.id}}" },
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "id": "{{user.id}}" },
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

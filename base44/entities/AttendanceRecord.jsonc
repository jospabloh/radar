{
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "check_in_time": {
      "type": "string"
    },
    "check_out_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "on_time",
        "late",
        "absent",
        "auto_logout",
        "extension"
      ],
      "default": "on_time"
    },
    "hours_worked": {
      "type": "number"
    },
    "extension_minutes": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "company_id",
    "date"
  ]
}
{
  // AttendanceRecord — one row per employee per day (check-in/out, hours,
  // status). create/update are scoped to the CALLER'S OWN employee_id (via
  // {{user.data.employee_id}}, set by completeOnboarding — see User.jsonc),
  // not just data.company_id. A company_id-only rule let any authenticated
  // employee in a company create/edit ANOTHER employee's attendance record
  // by passing a different employee_id (e.g. mark a coworker present, or
  // edit their hours_worked) since employee_id was client-supplied and
  // never checked against the caller's own identity.
  //
  // Manager writes to OTHER employees' rows (extension approval in
  // Approvals.jsx, incident notes in IncidentPanel.jsx) no longer qualify
  // under this narrower rule, so they go through the service-role function
  // `updateAttendanceRecord`, which verifies the caller's app_role and
  // tenant before writing via asServiceRole (role:admin branch below).
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "check_in_time": {
      "type": "string"
    },
    "check_out_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "on_time",
        "late",
        "absent",
        "auto_logout",
        "extension"
      ],
      "default": "on_time"
    },
    "hours_worked": {
      "type": "number"
    },
    "extension_minutes": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "company_id",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            { "data.company_id": "{{user.data.company_id}}" },
            { "data.employee_id": "{{user.data.employee_id}}" }
          ]
        },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            { "data.company_id": "{{user.data.company_id}}" },
            { "data.employee_id": "{{user.data.employee_id}}" }
          ]
        },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

{
  // SECURITY: `update`'s company-wide branch was removed — it had no
  // manager/admin app_role check, so any employee could promote themselves
  // or a coworker to company_admin via Employee.update(id, {role:
  // "company_admin"}). No client code in src/ calls entities.Employee.update
  // at all (the one caller, Approvals.jsx's schedule-approval reconciliation,
  // was moved into the service-role function resolveApprovalRequest), so
  // this closes the gap without touching Employee.create.
  //
  // SECURITY (2): `create` is now also service-role only — it had the same
  // gap at creation time (any company member could call Employee.create
  // directly with role: "company_admin"). Both legitimate creators
  // (EmployeeFormDialog.jsx for company_admin/store_manager,
  // SuperAdminCompanies.jsx for super_admin) now go through the
  // service-role function `createEmployee`, which validates the caller's
  // app_role, restricts which role they may grant, and pins company_id to
  // the caller's own tenant (or the requested tenant, for the super_admin
  // cross-company invite path) before writing via asServiceRole.
  "name": "Employee",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "company_admin",
        "store_manager",
        "employee"
      ],
      "default": "employee"
    },
    "schedule": {
      "type": "object",
      "properties": {
        "monday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "tuesday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "wednesday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "thursday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "friday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "saturday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "sunday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        }
      }
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "email",
    "full_name",
    "company_id"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "user_condition": { "role": "admin" }
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

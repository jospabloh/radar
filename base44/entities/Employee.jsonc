{
  // SECURITY: `update`'s company-wide branch was removed — it had no
  // manager/admin app_role check, so any employee could promote themselves
  // or a coworker to company_admin via Employee.update(id, {role:
  // "company_admin"}). No client code in src/ calls entities.Employee.update
  // at all (the one caller, Approvals.jsx's schedule-approval reconciliation,
  // was moved into the service-role function resolveApprovalRequest), so
  // this closes the gap without touching Employee.create (which still needs
  // to stay open for the employee-invite flow in EmployeeFormDialog.jsx —
  // locking `role` there would require rebuilding base44.users.inviteUser
  // behind a service-role function, which this sandbox has no live backend
  // to test against; left as a follow-up).
  "name": "Employee",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "company_admin",
        "store_manager",
        "employee"
      ],
      "default": "employee"
    },
    "schedule": {
      "type": "object",
      "properties": {
        "monday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "tuesday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "wednesday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "thursday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "friday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "saturday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "sunday": {
          "type": "object",
          "properties": {
            "works": {
              "type": "boolean"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        }
      }
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "email",
    "full_name",
    "company_id"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

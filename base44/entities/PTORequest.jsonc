{
  // SECURITY: `status`/`manager_comment` carry FIELD-LEVEL write RLS locking
  // them to role `admin` (service role). The top-level `update` rule only
  // checks tenant ownership (data.company_id), with no manager/admin
  // app_role check, so without this lock any employee could approve their
  // own (or a coworker's) PTO request by calling PTORequest.update directly.
  // Manager approve/reject now goes through the service-role function
  // `resolveApprovalRequest`, which verifies the caller's app_role before
  // writing via asServiceRole (role:admin branch below) — same pattern as
  // AttendanceRecord's `updateAttendanceRecord`. Approvals.jsx was the only
  // client-side writer of `status`/`manager_comment`; other fields (type,
  // dates, reason) remain self-service editable by the requester.
  "name": "PTORequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "vacaciones",
        "permiso_personal",
        "incapacidad",
        "dia_festivo",
        "otro"
      ],
      "default": "vacaciones"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "manager_comment": {
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "employee_id",
    "company_id",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

{
  // SECURITY: `status`/`manager_comment` carry FIELD-LEVEL write RLS locking
  // them to role `admin` (service role). The top-level `update` rule only
  // checks tenant ownership (data.company_id), with no manager/admin
  // app_role check, so without this lock any employee could approve their
  // own (or a coworker's) PTO request by calling PTORequest.update directly.
  // Manager approve/reject now goes through the service-role function
  // `resolveApprovalRequest`, which verifies the caller's app_role before
  // writing via asServiceRole (role:admin branch below) — same pattern as
  // AttendanceRecord's `updateAttendanceRecord`.
  //
  // SECURITY (2): `create` is now scoped to the caller's OWN employee_id
  // (via {{user.data.employee_id}}, same pattern as AttendanceRecord) — a
  // company_id-only create rule let any employee file a PTO request under a
  // COWORKER's employee_id/name, since both were client-supplied. And
  // `update`'s company-wide branch was removed entirely: no client code
  // calls entities.PTORequest.update anymore (Approvals.jsx's only write
  // moved into resolveApprovalRequest above), so there is nothing left that
  // legitimately needs to edit an existing request — not even the
  // requester editing their own pending dates/reason (no such UI exists).
  "name": "PTORequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "vacaciones",
        "permiso_personal",
        "incapacidad",
        "dia_festivo",
        "otro"
      ],
      "default": "vacaciones"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "manager_comment": {
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "employee_id",
    "company_id",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            { "data.company_id": "{{user.data.company_id}}" },
            { "data.employee_id": "{{user.data.employee_id}}" }
          ]
        },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

{
  // SECURITY: `status` carries FIELD-LEVEL write RLS locking it to role
  // `admin` (service role) — same reasoning as PTORequest.jsonc: the
  // top-level `update` rule has no manager/admin app_role check, so any
  // employee could approve their own schedule change directly. Manager
  // approve/reject now goes through the service-role function
  // `resolveApprovalRequest`, which also reconciles Employee.schedule on
  // approval (moved out of Approvals.jsx's direct client write).
  //
  // SECURITY (2): `create` and `update` are now service-role only. Unlike
  // PTORequest/ExtensionRequest, this entity is manager-initiated (a manager
  // proposes a schedule change FOR another employee via Employees.jsx —
  // ScheduleChangeDialog.jsx is only reachable from that admin/manager
  // page), so scoping create to "own employee_id" would break the
  // legitimate flow. There's no declarative RLS way to require "caller is a
  // manager", so creation now goes through the service-role function
  // `createManagedRecord`, which checks app_role the same way
  // `resolveApprovalRequest` does. `update` has no client caller left at
  // all (approval also moved to resolveApprovalRequest above).
  "name": "ScheduleChangeRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "proposed_schedule": {
      "type": "object"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "employee_id",
    "company_id",
    "proposed_schedule"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "user_condition": { "role": "admin" }
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

{
  // SECURITY: create/update dropped the "any company member" branch
  // (data.company_id match) — it let a coworker silently disable another
  // user's notification prefs (e.g. suppress their approval/incident
  // alerts), a write-side IDOR against another user's own settings.
  // NotificationSettings.jsx is the only caller and always scopes writes to
  // the caller's own user_id ({{user.id}}), so owner-or-admin is sufficient
  // there. `read` keeps the company-wide branch (required by
  // scripts/validate-entity-rls.mjs for any tenant-scoped entity, and lower
  // risk — reading a coworker's on/off toggle isn't sensitive).
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true
    },
    "whatsapp_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

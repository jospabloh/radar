{
  // SECURITY: `create`/`update` are now service-role only. No client code in
  // src/ writes Holiday at all (AttendanceCalendar.jsx only reads it) — the
  // previous company-wide write rule was an unused-but-open door for any
  // employee to tamper with company holidays. Locking it now, before any
  // creation UI exists, rather than after.
  "name": "Holiday",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "company_id",
    "name",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "user_condition": { "role": "admin" }
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

{
  // Module 3's per-tenant override layer: one row per (company_id, role_key),
  // holding only the keys a company_admin has explicitly turned on or off for
  // that role. Absent keys fall through to the registry default in
  // src/lib/permissionRegistry.js — this is deliberately sparse, so changing a
  // default in the registry still reaches every tenant that never overrode it.
  //
  // SECURITY (module 14 audit, closed here): create/update/delete were
  // previously company-scoped with no app_role check — the same shape of gap
  // Employee.jsonc and ShiftTemplate.jsonc document above their own RLS
  // blocks. Any employee or store_manager could rewrite their own company's
  // PermissionProfile row and grant themselves any key that the five
  // server-side Safe functions (_shared/_permissions.ts) then trust
  // unconditionally. RLS's `user_condition` can only check Base44's platform
  // `role`, never the custom `app_role` field, so — same as those two
  // siblings — create/update/delete are now service-role only. There is no
  // client write path today (no UI calls entities.PermissionProfile.create/
  // update; PermissionContext.jsx only reads), so this closes the gap
  // without breaking any caller; a future "edit role overrides" feature must
  // go through a service-role function that checks the caller is
  // company_admin (or super_admin) for their own company_id first, the same
  // shape as createEmployee.
  //
  // `read` stays company-wide on purpose: PermissionContext.jsx has to load
  // the caller's own role overrides at mount, and every backend Safe function
  // reads the row for the acting role before allowing a write.
  "name": "PermissionProfile",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant this profile belongs to."
    },
    "role_key": {
      "type": "string",
      "enum": ["company_admin", "store_manager", "employee"],
      "description": "Which app_role these overrides apply to. super_admin is never listed: it is an unconditional bypass, not an overridable role."
    },
    "label": {
      "type": "string"
    },
    "permissions": {
      "type": "object",
      "description": "Sparse map of 'Section:action' -> boolean. Only keys present here override the registry default for role_key."
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": ["company_id", "role_key"],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "user_condition": { "role": "admin" }
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

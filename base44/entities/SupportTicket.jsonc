    },
    "company_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "abierto",
        "en_proceso",
        "resuelto"

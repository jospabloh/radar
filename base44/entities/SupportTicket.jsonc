{
  // SECURITY: `create` now also requires data.created_by_id == {{user.id}}.
  // Previously any tenant member could set created_by_id/created_by_email to
  // an arbitrary value — both current client callers (LicenseManagement.jsx,
  // SupportCenter.jsx) already always set it to the caller's own id, so this
  // just closes the gap for a direct SDK call spoofing another employee (or
  // impersonating support staff by writing an owner-looking identity) within
  // the caller's own tenant.
  "name": "SupportTicket",
  "type": "object",
  "description": "Ticket de soporte que una empresa (tenant) abre a la plataforma ACACIA. Los mensajes del hilo viven en SupportTicketMessage.",
  "properties": {
    "company_id": { "type": "string", "description": "ID de la empresa que abrió el ticket (tenant)" },
    "company_name": { "type": "string", "description": "Nombre de la empresa (denormalizado)" },
    "employee_id": { "type": "string", "description": "ID del empleado relacionado (si aplica)" },
    "employee_name": { "type": "string", "description": "Nombre del empleado que reporta (denormalizado)" },
    "subject": { "type": "string", "description": "Asunto del ticket" },
    "description": { "type": "string", "description": "Descripción inicial del problema" },
    "category": { "type": "string", "enum": ["billing", "technical", "account", "attendance", "scheduling", "other"], "default": "other", "description": "Categoría" },
    "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"], "default": "normal", "description": "Prioridad" },
    "status": { "type": "string", "enum": ["open", "in_progress", "waiting_customer", "resolved", "closed"], "default": "open", "description": "Estado del ticket" },
    "created_by_id": { "type": "string", "description": "ID del usuario que lo creó" },
    "created_by_email": { "type": "string", "description": "Email del creador" },
    "assigned_to": { "type": "string", "description": "Email del agente de soporte asignado (owner)" },
    "first_response_at": { "type": "string", "format": "date-time", "description": "Primera respuesta del soporte" },
    "resolved_at": { "type": "string", "format": "date-time", "description": "Cuándo se resolvió" },
    "closed_at": { "type": "string", "format": "date-time", "description": "Cuándo se cerró" },
    "last_message_at": { "type": "string", "format": "date-time", "description": "Último mensaje en el hilo" },
    "last_message_by_role": { "type": "string", "enum": ["owner", "tenant"], "description": "Quién envió el último mensaje" },
    "messages_count": { "type": "number", "default": 0, "description": "Número de mensajes en el hilo" },
    "unread_for_owner": { "type": "boolean", "default": true, "description": "Hay mensajes sin leer para el soporte" },
    "unread_for_tenant": { "type": "boolean", "default": false, "description": "Hay mensajes sin leer para la empresa" },
    "metadata": { "type": "object", "description": "Datos adicionales" },
    "ai_brief": { "type": "object", "description": "Especificación estructurada que arma el asistente BA/PO al levantar un feature o incidencia (historia de usuario, criterios de aceptación, pasos de reproducción, impacto, etc.). El mismo brief se incrusta en 'description' en Markdown, así que este campo es aditivo para el render enriquecido en Mission Control." }
  },
  "required": ["company_id", "subject"],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            { "data.company_id": "{{user.data.company_id}}" },
            { "data.created_by_id": "{{user.id}}" }
          ]
        },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

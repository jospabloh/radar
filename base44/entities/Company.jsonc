{
  // SECURITY: tier/max_employees/license_expiry/status carry FIELD-LEVEL
  // write RLS locking them to role `admin` (service role). Company's
  // top-level `update` rule only checks tenant ownership (id ==
  // {{user.data.company_id}}), so without this lock any employee could
  // call Company.update on their own company with {tier:"enterprise",
  // status:"active", ...} and grant themselves a paid tier or lift a
  // suspension directly, bypassing the SupportTicket-based upgrade request
  // flow in LicenseManagement.jsx (the only legitimate writer of these
  // fields is a human via the Base44 dashboard / a future service-role
  // billing function). CompanySettings.jsx (the only other Company.update
  // caller) only ever writes name/timezone/whatsapp_enabled, so this lock
  // does not affect it.
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "is_mexican": {
      "type": "boolean",
      "default": true
    },
    "timezone": {
      "type": "string",
      "default": "America/Mexico_City"
    },
    "whatsapp_enabled": {
      "type": "boolean",
      "default": false
    },
    "tier": {
      "type": "string",
      "enum": [
        "starter",
        "pro",
        "enterprise"
      ],
      "default": "starter",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "max_employees": {
      "type": "number",
      "default": 15,
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "license_expiry": {
      "type": "string",
      "format": "date",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "view_only"
      ],
      // view_only agregado 2026-08-03: cierra el hueco de solo-lectura (día 8
      // del ciclo unificado de licencias) que Radar no tenía — ver
      // docs/superpowers/specs/2026-08-03-portfolio-license-lifecycle-design.md
      // en acacia-mission-control. Committear este .jsonc NO cambia el
      // schema desplegado en Base44 — falta el deploy real (Base44 MCP) y
      // luego flippear `readOnlyStatus: null` -> `'view_only'` en
      // acacia-mission-control/api/_lib/licenseControl.js para radar.
      "default": "active",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        { "id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "user_condition": { "role": "admin" }
    },
    "update": {
      "$or": [
        { "id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

{
  // SECURITY: create/update/delete are now service-role only. The previous
  // company-wide create/update rule had no manager role check (any employee
  // could rewrite company-wide shift templates), and `delete` was already
  // (silently) service-role only — meaning ShiftSettings.jsx's delete button
  // was already broken for every real user, since no `role: admin` end user
  // exists. Create/delete now go through the manager-gated service-role
  // function `createManagedRecord` (create) reusing the same MANAGER_ROLES
  // check as `resolveApprovalRequest`; `update` has no client caller at all
  // (ShiftSettings.jsx only creates and deletes).
  "name": "ShiftTemplate",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "start": {
      "type": "string"
    },
    "end": {
      "type": "string"
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday",
          "sunday"
        ]
      }
    }
  },
  "required": [
    "company_id",
    "name",
    "start",
    "end"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "user_condition": { "role": "admin" }
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

{
  // SECURITY: `status` carries FIELD-LEVEL write RLS locking it to role
  // `admin` (service role) — same reasoning as PTORequest.jsonc. Note the
  // underlying AttendanceRecord write on approval was already manager-gated
  // via `updateAttendanceRecord`, but the ExtensionRequest's own status flip
  // was not — an employee could mark their own extension "approved" without
  // ever touching the attendance record itself, which is misleading even
  // though it granted no extra hours. Approve/reject now goes through the
  // service-role function `resolveApprovalRequest`.
  //
  // SECURITY (2): `create` is now scoped to the caller's OWN employee_id
  // (same reasoning/pattern as PTORequest.jsonc — prevents filing an
  // extension request under a coworker's identity), and `update`'s
  // company-wide branch was removed entirely (no client code calls
  // entities.ExtensionRequest.update anymore).
  "name": "ExtensionRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "attendance_record_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "requested_minutes": {
      "type": "number",
      "default": 30
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "employee_id",
    "company_id",
    "attendance_record_id"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.company_id": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            { "data.company_id": "{{user.data.company_id}}" },
            { "data.employee_id": "{{user.data.employee_id}}" }
          ]
        },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}

{
  "description": "Marca ausencias autom\u00e1ticas y hace auto-logout de jornadas abiertas cada 15 minutos",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "attendance_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_monitor": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "attendanceMonitor",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Revisar asistencia",
            "description": "Ausencias y auto-logout"
          }
        }
      }
    ]
  },
  "name": "Monitor de Asistencia"
}